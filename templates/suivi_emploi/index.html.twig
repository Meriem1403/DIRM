{% extends 'base.html.twig' %}

{% block title %}Suivi des Emplois{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Suivi des Emplois</h1>
            <p class="text-gray-600 mt-2">Gestion et suivi des effectifs</p>
        </div>

        <!-- Messages flash -->
        {% for message in app.flashes('warning') %}
        <div class="mb-4 bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">{{ message }}</span>
        </div>
        {% endfor %}

        <!-- Contenu principal -->
        <div class="bg-white rounded-lg shadow">
            <div class="p-6">
                <p class="text-gray-600">Page en construction...</p>
                <p class="text-sm text-gray-500 mt-2">Nombre d'enregistrements : {{ suivi_emplois|length }}</p>
            </div>
        </div>

    </div>
</div>
{% endblock %}

