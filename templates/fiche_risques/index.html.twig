{% extends 'base.html.twig' %}

{% block title %}Fiche des risques{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .risks-container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .page-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            padding: 32px;
            margin-bottom: 32px;
            color: white;
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.3);
        }

        .page-header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0 0 8px 0;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .page-header p {
            font-size: 1.1rem;
            opacity: 0.9;
            margin: 0;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: rgba(255, 255, 255, 0.2);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: background 0.2s;
            margin-bottom: 20px;
        }

        .back-button:hover {
            background: rgba(255, 255, 255, 0.3);
            color: white;
        }

        .risks-list {
            background: white;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            border: 1px solid #e5e7eb;
        }

        .risk-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            border-bottom: 1px solid #e5e7eb;
            transition: background 0.2s;
            cursor: pointer;
        }

        .risk-item:last-child {
            border-bottom: none;
        }

        .risk-item:hover {
            background: #f9fafb;
        }

        .risk-item-left {
            flex: 1;
        }

        .risk-item-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #111827;
            margin-bottom: 8px;
        }

        .risk-item-meta {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            font-size: 13px;
            color: #6b7280;
        }

        .risk-item-meta span {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .risk-item-meta i {
            color: #9ca3af;
        }

        .risk-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-critique {
            background-color: #fef2f2;
            color: #dc2626;
        }

        .badge-eleve {
            background-color: #fff7ed;
            color: #ea580c;
        }

        .badge-moyen {
            background-color: #fefce8;
            color: #ca8a04;
        }

        .badge-faible {
            background-color: #f0fdf4;
            color: #16a34a;
        }

        .view-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: #667eea;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            transition: background 0.2s;
        }

        .view-link:hover {
            background: #5568d3;
            color: white;
        }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
        }

        .empty-state-icon {
            font-size: 5rem;
            color: #d1d5db;
            margin-bottom: 24px;
        }

        .empty-state-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #111827;
            margin-bottom: 8px;
        }

        .empty-state-text {
            color: #6b7280;
            font-size: 1rem;
        }

        @media (max-width: 768px) {
            .risk-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .view-link {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="risks-container">
    <a href="{{ path('mes_risques') }}" class="back-button">
        <i class="fas fa-arrow-left"></i>
        Retour à Mes Risques
    </a>

    <div class="page-header">
        <h1>
            <i class="fas fa-file-alt"></i>
            Fiche des risques
        </h1>
        <p>Consultez la liste des risques et accédez à leurs fiches simplifiées</p>
    </div>

    {% if risques|length > 0 %}
        <div class="risks-list">
            {% for risque in risques %}
            <div class="risk-item" onclick="window.location.href='{{ path('fiche_risques_detail', {id: risque.id}) }}'">
                <div class="risk-item-left">
                    <div class="risk-item-title">{{ risque.titre }}</div>
                    <div class="risk-item-meta">
                        <span>
                            <i class="fas fa-building"></i>
                            {{ risque.service.nom }}
                        </span>
                        <span>
                            <i class="fas fa-user"></i>
                            {{ risque.responsable.prenom }} {{ risque.responsable.nom }}
                        </span>
                        <span>
                            <i class="fas fa-calendar-alt"></i>
                            {{ risque.dateDetection|date('d/m/Y') }}
                        </span>
                        <span>
                            {% set niveauClass = 'faible' %}
                            {% if risque.niveauRisque == 'critique' %}
                                {% set niveauClass = 'critique' %}
                            {% elseif risque.niveauRisque == 'élevé' %}
                                {% set niveauClass = 'eleve' %}
                            {% elseif risque.niveauRisque == 'moyen' %}
                                {% set niveauClass = 'moyen' %}
                            {% endif %}
                            <span class="risk-badge badge-{{ niveauClass }}">
                                <i class="fas fa-exclamation-triangle"></i>
                                {{ risque.niveauRisque|capitalize }}
                            </span>
                        </span>
                    </div>
                </div>
                <a href="{{ path('fiche_risques_detail', {id: risque.id}) }}" class="view-link" onclick="event.stopPropagation()">
                    Voir la fiche
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-inbox"></i>
            </div>
            <h3 class="empty-state-title">Aucun risque enregistré</h3>
            <p class="empty-state-text">Il n'y a actuellement aucun risque dans le système.</p>
        </div>
    {% endif %}
</div>
{% endblock %}
