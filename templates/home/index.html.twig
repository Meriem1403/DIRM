{# templates/home/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Accueil — DIRM{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# Prélodage des images du hero #}
    {% for src in heroImages %}
        <link rel="preload" as="image" href="{{ asset(src) }}">
    {% endfor %}
{% endblock %}

{% block body %}
    {# --- Header fixe --- #}
    {% include 'home/partials/_header.html.twig' %}

    {# Décalage pour laisser la place au header (hauteur ≃ 4rem) #}
    <div class="pt-16">
        {# --- Hero full viewport --- #}
        {% include 'home/partials/_hero.html.twig' with {
            backgroundImages: heroImages,
            title:    'Bienvenue sur la plateforme DIRM',
            subtitle: 'Gérez vos accès, demandes et validations informatiques',
            button:   { href: '#', text: '' }
        } %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Précharge aussi via JS au cas où
        document.addEventListener('DOMContentLoaded', () => {
            window.heroImages.forEach(src => {
                const img = new Image();
                img.src = "{{ asset('') }}" + src;
            });
        });
    </script>
{% endblock %}
