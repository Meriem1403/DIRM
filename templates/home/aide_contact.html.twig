{% extends 'base.html.twig' %}

{% block title %}Aide & Contact{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-6">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Aide & Contact</h1>
            <p class="text-gray-600 mt-2">Besoin d'aide ? Contactez-nous</p>
        </div>

        <!-- Contenu -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            
            <!-- Informations de contact -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">
                    <i class="fas fa-phone mr-2 text-blue-600"></i>Contact
                </h2>
                <div class="space-y-3">
                    <div class="flex items-center">
                        <i class="fas fa-envelope text-gray-500 mr-3"></i>
                        <span class="text-gray-700">contact@dirm.fr</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-phone text-gray-500 mr-3"></i>
                        <span class="text-gray-700">01 23 45 67 89</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-map-marker-alt text-gray-500 mr-3"></i>
                        <span class="text-gray-700">DIRM Méditerranée<br>Marseille, France</span>
                    </div>
                </div>
            </div>

            <!-- Support technique -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">
                    <i class="fas fa-tools mr-2 text-green-600"></i>Support Technique
                </h2>
                <div class="space-y-3">
                    <div class="flex items-center">
                        <i class="fas fa-envelope text-gray-500 mr-3"></i>
                        <span class="text-gray-700">support@dirm.fr</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-clock text-gray-500 mr-3"></i>
                        <span class="text-gray-700">Lun-Ven : 9h-17h</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-headset text-gray-500 mr-3"></i>
                        <span class="text-gray-700">Assistance en ligne</span>
                    </div>
                </div>
            </div>

            <!-- FAQ -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">
                    <i class="fas fa-question-circle mr-2 text-purple-600"></i>Questions Fréquentes
                </h2>
                <div class="space-y-3">
                    <div>
                        <h3 class="font-medium text-gray-900">Comment créer une demande ?</h3>
                        <p class="text-sm text-gray-600">Rendez-vous dans "Vos démarches" et sélectionnez le type de demande souhaité.</p>
                    </div>
                    <div>
                        <h3 class="font-medium text-gray-900">Comment consulter mes risques ?</h3>
                        <p class="text-sm text-gray-600">Accédez à "Mes Risques" depuis votre tableau de bord.</p>
                    </div>
                    <div>
                        <h3 class="font-medium text-gray-900">Problème de connexion ?</h3>
                        <p class="text-sm text-gray-600">Contactez le support technique avec votre identifiant.</p>
                    </div>
                </div>
            </div>

            <!-- Documentation -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">
                    <i class="fas fa-book mr-2 text-orange-600"></i>Documentation
                </h2>
                <div class="space-y-3">
                    <a href="#" class="block text-blue-600 hover:text-blue-800">
                        <i class="fas fa-download mr-2"></i>Guide utilisateur (PDF)
                    </a>
                    <a href="#" class="block text-blue-600 hover:text-blue-800">
                        <i class="fas fa-video mr-2"></i>Tutoriels vidéo
                    </a>
                    <a href="#" class="block text-blue-600 hover:text-blue-800">
                        <i class="fas fa-file-alt mr-2"></i>Procédures internes
                    </a>
                </div>
            </div>
        </div>

        <!-- Formulaire de contact -->
        <div class="mt-8 bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">
                <i class="fas fa-paper-plane mr-2 text-blue-600"></i>Nous contacter
            </h2>
            <form class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="nom" class="block text-sm font-medium text-gray-700 mb-1">Nom</label>
                        <input type="text" id="nom" name="nom" 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                        <input type="email" id="email" name="email" 
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>
                <div>
                    <label for="sujet" class="block text-sm font-medium text-gray-700 mb-1">Sujet</label>
                    <input type="text" id="sujet" name="sujet" 
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
                    <textarea id="message" name="message" rows="4" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                              placeholder="Décrivez votre demande ou votre problème..."></textarea>
                </div>
                <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 transition-colors duration-300">
                    <i class="fas fa-paper-plane mr-2"></i>Envoyer le message
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
