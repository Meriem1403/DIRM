<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon" href="{{ asset('uploads/logo/favicon.png') }}">

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body>
{# ✅ On inclut le header ici sauf si une page demande à le masquer #}
{% if hide_header is not defined or not hide_header %}
    {% include 'home/partials/_header.html.twig' %}
{% endif %}

{% block body %}{% endblock %}
</body>
</html>
