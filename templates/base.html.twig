{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>

    {# favicon #}
    <link rel="icon" href="{{ asset('uploads/logo/favicon.png') }}" type="image/png">

    {# ——————————————————————————————————————————————
       Feuilles de style
       —————————————————————————————————————————————— #}
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {# Font Awesome pour les icônes #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        /* Force header visibility */
        #main-header {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            z-index: 99999 !important;
            background-color: rgba(255, 255, 255, 0.98) !important;
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
        body {
            padding-top: 80px !important;
        }
    </style>
</head>
<body class="antialiased font-sans text-gray-900">

{# ——————————————————————————————————————————————
   Header (on peut masquer avec hide_header=true)
   —————————————————————————————————————————————— #}
{% if hide_header is not defined or not hide_header %}
    {% include 'home/partials/_header.html.twig' %}
{% endif %}


{# ——————————————————————————————————————————————
   Contenu principal
   pt-20 pour compenser header h-20 (5rem = 80px),
   md:pt-24 si tu veux plus d'air en tablette/desktop
   pb-20 pour laisser de l'espace sous le contenu
   md:pb-24 en grand écran
   —————————————————————————————————————————————— #}
<main id="main-content" class="pt-20 md:pt-24 pb-20 md:pb-24 min-h-screen">
    <div class="w-full max-w-full mx-auto px-4 sm:px-6 lg:px-8">
        {% block body %}{% endblock %}
    </div>
</main>

{# ——————————————————————————————————————————————
   Footer (on peut masquer avec hide_footer=true)
   —————————————————————————————————————————————— #}
{% if hide_footer is not defined or not hide_footer %}
    {% include 'home/partials/_footer.html.twig' %}
{% endif %}

{# ——————————————————————————————————————————————
   Scripts JS (Webpack Encore)
   —————————————————————————————————————————————— #}
{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}

</body>
</html>
