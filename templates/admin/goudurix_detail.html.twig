{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block content_title %}
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Détail du Risque</h1>
        <p class="text-sm text-gray-600 mt-1">Informations complètes sur le risque sélectionné</p>
    </div>
{% endblock %}

{% block main %}
    <div class="min-h-screen bg-gray-50 py-6">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Header du risque -->
            <div class="bg-white rounded-lg shadow p-6 mb-6">
                <div class="flex items-start justify-between">
                    <div class="flex-1">
                        <h2 class="text-3xl font-bold text-gray-900 mb-2">{{ entity.instance.titre }}</h2>
                        <p class="text-lg text-gray-600 mb-4">{{ entity.instance.service.nom }}</p>
                        <p class="text-gray-700 leading-relaxed">{{ entity.instance.description }}</p>
                    </div>
                    <div class="flex flex-col space-y-3">
                        <!-- Badge niveau de risque -->
                        <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium
                            {% if entity.instance.niveauRisque == 'critique' %}bg-red-100 text-red-800
                            {% elseif entity.instance.niveauRisque == 'élevé' %}bg-orange-100 text-orange-800
                            {% elseif entity.instance.niveauRisque == 'moyen' %}bg-yellow-100 text-yellow-800
                            {% else %}bg-green-100 text-green-800{% endif %}">
                            <i class="fas fa-exclamation-triangle mr-2"></i>
                            {{ entity.instance.niveauRisque|capitalize }}
                        </span>
                        
                        <!-- Badge statut -->
                        <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium
                            {% if entity.instance.statut == 'en_cours' %}bg-blue-100 text-blue-800
                            {% elseif entity.instance.statut == 'traité' %}bg-green-100 text-green-800
                            {% elseif entity.instance.statut == 'surveillé' %}bg-yellow-100 text-yellow-800
                            {% else %}bg-gray-100 text-gray-800{% endif %}">
                            {% if entity.instance.statut == 'en_cours' %}<i class="fas fa-clock mr-2"></i>
                            {% elseif entity.instance.statut == 'traité' %}<i class="fas fa-check mr-2"></i>
                            {% elseif entity.instance.statut == 'surveillé' %}<i class="fas fa-eye mr-2"></i>
                            {% else %}<i class="fas fa-archive mr-2"></i>{% endif %}
                            {{ entity.instance.statut|replace({'_': ' '})|capitalize }}
                        </span>

                        {% if entity.instance.scoreRisque %}
                        <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-indigo-100 text-indigo-800">
                            <i class="fas fa-chart-line mr-2"></i>
                            Score: {{ entity.instance.scoreRisque }}/25
                        </span>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Informations principales -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                <!-- Informations générales -->
                <div class="bg-white rounded-lg shadow p-6">
                    <h3 class="text-xl font-semibold text-gray-900 mb-4">Informations Générales</h3>
                    <dl class="space-y-4">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Responsable</dt>
                            <dd class="text-gray-900">{{ entity.instance.responsable.nom }} {{ entity.instance.responsable.prenom }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Créateur</dt>
                            <dd class="text-gray-900">{{ entity.instance.createur.nom }} {{ entity.instance.createur.prenom }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Date de détection</dt>
                            <dd class="text-gray-900">{{ entity.instance.dateDetection|date('d/m/Y') }}</dd>
                        </div>
                        {% if entity.instance.dateResolution %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Date de résolution</dt>
                            <dd class="text-gray-900">{{ entity.instance.dateResolution|date('d/m/Y') }}</dd>
                        </div>
                        {% endif %}
                        {% if entity.instance.lieu %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Lieu</dt>
                            <dd class="text-gray-900">{{ entity.instance.lieu.nom }}</dd>
                        </div>
                        {% endif %}
                        {% if entity.instance.categorie %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Catégorie</dt>
                            <dd class="text-gray-900">{{ entity.instance.categorie }}</dd>
                        </div>
                        {% endif %}
                        {% if entity.instance.source %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Source</dt>
                            <dd class="text-gray-900">{{ entity.instance.source }}</dd>
                        </div>
                        {% endif %}
                    </dl>
                </div>

                <!-- Évaluation du risque -->
                <div class="bg-white rounded-lg shadow p-6">
                    <h3 class="text-xl font-semibold text-gray-900 mb-4">Évaluation du Risque</h3>
                    <dl class="space-y-4">
                        {% if entity.instance.probabilite %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Probabilité</dt>
                            <dd class="text-gray-900">
                                <div class="flex items-center">
                                    <div class="flex-1 bg-gray-200 rounded-full h-2 mr-3">
                                        <div class="bg-blue-600 h-2 rounded-full" style="width: {{ (entity.instance.probabilite / 5) * 100 }}%"></div>
                                    </div>
                                    <span class="text-sm font-medium">{{ entity.instance.probabilite }}/5</span>
                                </div>
                            </dd>
                        </div>
                        {% endif %}
                        {% if entity.instance.gravite %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Gravité</dt>
                            <dd class="text-gray-900">
                                <div class="flex items-center">
                                    <div class="flex-1 bg-gray-200 rounded-full h-2 mr-3">
                                        <div class="bg-red-600 h-2 rounded-full" style="width: {{ (entity.instance.gravite / 5) * 100 }}%"></div>
                                    </div>
                                    <span class="text-sm font-medium">{{ entity.instance.gravite }}/5</span>
                                </div>
                            </dd>
                        </div>
                        {% endif %}
                        {% if entity.instance.scoreRisque %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Score de risque</dt>
                            <dd class="text-gray-900">
                                <div class="flex items-center">
                                    <div class="flex-1 bg-gray-200 rounded-full h-2 mr-3">
                                        <div class="bg-purple-600 h-2 rounded-full" style="width: {{ (entity.instance.scoreRisque / 25) * 100 }}%"></div>
                                    </div>
                                    <span class="text-sm font-medium">{{ entity.instance.scoreRisque }}/25</span>
                                </div>
                            </dd>
                        </div>
                        {% endif %}
                    </dl>
                </div>
            </div>

            <!-- Mesures et retours d'action -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                <!-- Mesures -->
                <div class="bg-white rounded-lg shadow p-6">
                    <h3 class="text-xl font-semibold text-gray-900 mb-4">Mesures</h3>
                    
                    {% if entity.instance.mesureEnCours %}
                    <div class="mb-4">
                        <h4 class="text-sm font-medium text-gray-700 mb-2">Mesure en cours</h4>
                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                            <p class="text-blue-900 mb-3">{{ entity.instance.mesureEnCours }}</p>
                            <div class="flex items-center justify-between">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium
                                    {% if entity.instance.mesureMiseEnPlace %}bg-green-100 text-green-800{% else %}bg-yellow-100 text-yellow-800{% endif %}">
                                    {% if entity.instance.mesureMiseEnPlace %}✓ Mise en place{% else %}⏳ En cours{% endif %}
                                </span>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    {% if entity.instance.mesuresPreventives %}
                    <div class="mb-4">
                        <h4 class="text-sm font-medium text-gray-700 mb-2">Mesures préventives</h4>
                        <p class="text-gray-700">{{ entity.instance.mesuresPreventives }}</p>
                    </div>
                    {% endif %}

                    {% if entity.instance.mesuresCorrectives %}
                    <div class="mb-4">
                        <h4 class="text-sm font-medium text-gray-700 mb-2">Mesures correctives</h4>
                        <p class="text-gray-700">{{ entity.instance.mesuresCorrectives }}</p>
                    </div>
                    {% endif %}
                </div>

                <!-- Retours d'action -->
                <div class="bg-white rounded-lg shadow p-6">
                    <h3 class="text-xl font-semibold text-gray-900 mb-4">Retours d'Action</h3>
                    
                    {% if entity.instance.retourAction %}
                    <div class="mb-4">
                        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                            <p class="text-green-900 mb-3">{{ entity.instance.retourAction }}</p>
                            <div class="flex items-center justify-between text-sm text-green-700">
                                <span>
                                    {% if entity.instance.auteurRetour %}
                                        Par {{ entity.instance.auteurRetour.nom }} {{ entity.instance.auteurRetour.prenom }}
                                    {% endif %}
                                </span>
                                <span>
                                    {% if entity.instance.dateRetour %}
                                        Le {{ entity.instance.dateRetour|date('d/m/Y à H:i') }}
                                    {% endif %}
                                </span>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    {% if entity.instance.commentaires %}
                    <div class="mb-4">
                        <h4 class="text-sm font-medium text-gray-700 mb-2">Commentaires</h4>
                        <p class="text-gray-700">{{ entity.instance.commentaires }}</p>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Observateurs -->
            {% if entity.instance.observateurs|length > 0 %}
            <div class="bg-white rounded-lg shadow p-6 mb-6">
                <h3 class="text-xl font-semibold text-gray-900 mb-4">Observateurs</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {% for observateur in entity.instance.observateurs %}
                    <div class="flex items-center space-x-3">
                        <div class="bg-blue-100 rounded-full p-2">
                            <i class="fas fa-user text-blue-600"></i>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-gray-900">{{ observateur.nom }} {{ observateur.prenom }}</p>
                            <p class="text-sm text-gray-500">{{ observateur.email }}</p>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <!-- Métadonnées -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-xl font-semibold text-gray-900 mb-4">Métadonnées</h3>
                <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Créé le</dt>
                        <dd class="text-gray-900">{{ entity.instance.createdAt|date('d/m/Y à H:i') }}</dd>
                    </div>
                    {% if entity.instance.updatedAt %}
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Modifié le</dt>
                        <dd class="text-gray-900">{{ entity.instance.updatedAt|date('d/m/Y à H:i') }}</dd>
                    </div>
                    {% endif %}
                </dl>
            </div>
        </div>
    </div>
{% endblock %}
