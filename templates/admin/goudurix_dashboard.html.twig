{% extends 'base.html.twig' %}

{% block title %}Dashboard Risques{% endblock %}

{% block body %}
<style>
    .btn-nav-retour, .btn-nav-ajouter, .btn-carte-voir, .btn-carte-ajouter {
        display: inline-block !important;
        visibility: visible !important;
        opacity: 1 !important;
        padding: 0.5rem 1rem !important;
        border-radius: 0.375rem !important;
        text-decoration: none !important;
        font-weight: 500 !important;
        cursor: pointer !important;
        transition: background-color 0.2s !important;
    }
    .btn-nav-retour {
        background-color: #9ca3af !important;
        color: #ffffff !important;
    }
    .btn-nav-retour:hover {
        background-color: #6b7280 !important;
    }
    .btn-nav-ajouter {
        background-color: #818cf8 !important;
        color: #ffffff !important;
    }
    .btn-nav-ajouter:hover {
        background-color: #6366f1 !important;
    }
    .btn-carte-voir {
        background-color: #60a5fa !important;
        color: #ffffff !important;
        flex: 1 !important;
    }
    .btn-carte-voir:hover {
        background-color: #3b82f6 !important;
    }
    .btn-carte-ajouter {
        background-color: #2dd4bf !important;
        color: #ffffff !important;
        flex: 1 !important;
    }
    .btn-carte-ajouter:hover {
        background-color: #14b8a6 !important;
    }
</style>
<div class="min-h-screen bg-gray-50">
    <div class="w-full px-4 sm:px-6 lg:px-8" style="padding-top: 0.5rem;">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-xl font-semibold text-gray-900">Services</h1>
            <div class="flex gap-3" style="gap: 0.75rem;">
                <a href="{{ retourUrl ?? path('admin', {'crudAction': 'index', 'crudControllerFqcn': 'App\\\\Controller\\\\Admin\\\\GoudurixCrudController'}) }}" 
                   class="btn-nav-retour">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
                <a href="{{ ajouterUrl ?? path('admin', {'crudAction': 'new', 'crudControllerFqcn': 'App\\\\Controller\\\\Admin\\\\GoudurixCrudController'}) }}" 
                   class="btn-nav-ajouter">
                    <i class="fas fa-plus"></i> Ajouter un risque
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            {% for serviceData in services %}
                {% set service = serviceData.service %}
                {% set risques = serviceData.risques %}
                
                <div class="bg-white rounded-lg border border-gray-200 p-4 hover:shadow-sm transition-shadow">
                    <div class="mb-3">
                        <h3 class="text-base font-medium text-gray-900">{{ service.nom }}</h3>
                        {% if service.lieux|length > 0 %}
                        <p class="text-xs text-gray-500 mt-1">{{ service.lieux|map(l => l.nom)|join(', ') }}</p>
                        {% endif %}
                    </div>
                    
                    <div class="flex justify-center items-center my-4">
                        <i class="fas fa-building text-4xl text-gray-400"></i>
                    </div>
                    
                    <div class="mb-4 text-sm">
                        <span class="text-gray-600">Risques:</span>
                        <span class="font-medium text-gray-900 ml-1">{{ risques|length }}</span>
                    </div>
                    
                    <div class="flex space-x-3 mt-4" style="gap: 0.75rem;">
                        <a href="{{ serviceData.voirUrl }}" 
                           class="btn-carte-voir text-center">
                            <i class="fas fa-eye"></i> Voir
                        </a>
                        <a href="{{ serviceData.ajouterUrl }}" 
                           class="btn-carte-ajouter text-center">
                            <i class="fas fa-plus"></i> Ajouter
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="col-span-full bg-white rounded-lg border border-gray-200 p-8 text-center">
                    <p class="text-gray-500">Aucun service disponible</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
