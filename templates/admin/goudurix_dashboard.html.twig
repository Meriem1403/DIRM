{% extends 'base.html.twig' %}

{% block title %}Gestion des Risques par Service{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-8">Gestion des Risques - DUERP</h1>
        
        <div class="mb-6">
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                <h3 class="text-lg font-semibold text-blue-900 mb-2">Interface de Saisie des Risques</h3>
                <p class="text-blue-700">Sélectionnez un service pour gérer ses risques, ajouter des mesures et suivre les retours d'action.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for serviceData in services %}
                {% set service = serviceData.service %}
                {% set risques = serviceData.risques %}
                <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 hover:shadow-lg transition-shadow duration-300">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center">
                            <div class="bg-blue-100 rounded-full p-3 mr-4">
                                <i class="fas fa-building text-blue-600 text-xl"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-semibold text-gray-900">{{ service.nom }}</h3>
                                <p class="text-sm text-gray-600">{{ service.lieux|length }} lieu(x)</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                {{ risques|length }} risque(s)
                            </span>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <div class="grid grid-cols-2 gap-4 text-sm">
                            <div>
                                <span class="text-gray-500">Critiques:</span>
                                <span class="font-semibold text-red-600">{{ risques|filter(r => r.niveauRisque == 'critique')|length }}</span>
                            </div>
                            <div>
                                <span class="text-gray-500">Élevés:</span>
                                <span class="font-semibold text-orange-600">{{ risques|filter(r => r.niveauRisque == 'élevé')|length }}</span>
                            </div>
                            <div>
                                <span class="text-gray-500">En cours:</span>
                                <span class="font-semibold text-blue-600">{{ risques|filter(r => r.statut == 'en_cours')|length }}</span>
                            </div>
                            <div>
                                <span class="text-gray-500">Traités:</span>
                                <span class="font-semibold text-green-600">{{ risques|filter(r => r.statut == 'traité')|length }}</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex space-x-2">
                        <a href="/admin/goudurix?filters[service]={{ service.id }}" 
                           class="flex-1 bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors duration-300 text-center text-sm font-medium">
                            <i class="fas fa-list mr-2"></i>Voir les Risques
                        </a>
                        <a href="/admin/goudurix/new?filters[service]={{ service.id }}" 
                           class="flex-1 bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 transition-colors duration-300 text-center text-sm font-medium">
                            <i class="fas fa-plus mr-2"></i>Nouveau Risque
                        </a>
                    </div>
                    
                    <!-- Liste des risques récents -->
                    {% if risques|length > 0 %}
                    <div class="mt-4">
                        <h4 class="text-sm font-medium text-gray-700 mb-2">Risques récents :</h4>
                        <div class="space-y-2">
                            {% for risque in risques|slice(0, 3) %}
                            <div class="flex items-center justify-between bg-gray-50 rounded p-2">
                                <div class="flex items-center space-x-2">
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium
                                        {% if risque.niveauRisque == 'critique' %}bg-red-100 text-red-800
                                        {% elseif risque.niveauRisque == 'élevé' %}bg-orange-100 text-orange-800
                                        {% elseif risque.niveauRisque == 'moyen' %}bg-yellow-100 text-yellow-800
                                        {% else %}bg-green-100 text-green-800{% endif %}">
                                        {{ risque.niveauRisque|capitalize }}
                                    </span>
                                    <span class="text-sm text-gray-700">{{ risque.titre }}</span>
                                </div>
                                <a href="/risque-detail/{{ risque.id }}" 
                                   class="text-blue-600 hover:text-blue-800 text-xs">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        
        <div class="mt-8 bg-gray-50 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Actions Rapides</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <a href="/admin/goudurix" 
                   class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow duration-300">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-triangle text-red-600 text-2xl mr-3"></i>
                        <div>
                            <h4 class="font-semibold text-gray-900">Gérer tous les Risques</h4>
                            <p class="text-sm text-gray-600">Interface EasyAdmin complète</p>
                        </div>
                    </div>
                </a>
                
                <a href="/services" target="_blank" 
                   class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow duration-300">
                    <div class="flex items-center">
                        <i class="fas fa-th-large text-purple-600 text-2xl mr-3"></i>
                        <div>
                            <h4 class="font-semibold text-gray-900">Cartes des Services</h4>
                            <p class="text-sm text-gray-600">Vue d'ensemble</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
