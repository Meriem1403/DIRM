{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block content_title %}
    <div class="flex items-start justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Gestion des Risques - DUERP</h1>
            <p class="text-sm text-gray-600 mt-1">Gestion des risques professionnels et DUERP (Document Unique d'Évaluation des Risques Professionnels)</p>
        </div>
        <div class="flex items-start space-x-2" style="margin-top: 4px;">
            <a href="/goudurix-dashboard" class="btn btn-primary">
                <i class="fa fa-th-large"></i> Dashboard
            </a>
        </div>
    </div>
{% endblock %}

{% block main %}
    <div class="min-h-screen bg-gray-50 py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Statistiques globales -->
            <div class="grid grid-cols-4 gap-4 mb-8">
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="bg-red-100 rounded-full p-2 mr-3">
                                <i class="fas fa-exclamation-triangle text-red-600"></i>
                            </div>
                            <div>
                                <p class="text-xs font-medium text-gray-600">Critiques</p>
                                <p class="text-lg font-bold text-red-600">{{ entities|filter(e => e.instance.niveauRisque == 'critique')|length }}</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="bg-orange-100 rounded-full p-2 mr-3">
                                <i class="fas fa-exclamation-circle text-orange-600"></i>
                            </div>
                            <div>
                                <p class="text-xs font-medium text-gray-600">Élevés</p>
                                <p class="text-lg font-bold text-orange-600">{{ entities|filter(e => e.instance.niveauRisque == 'élevé')|length }}</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="bg-blue-100 rounded-full p-2 mr-3">
                                <i class="fas fa-clock text-blue-600"></i>
                            </div>
                            <div>
                                <p class="text-xs font-medium text-gray-600">En Cours</p>
                                <p class="text-lg font-bold text-blue-600">{{ entities|filter(e => e.instance.statut == 'en_cours')|length }}</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="bg-green-100 rounded-full p-2 mr-3">
                                <i class="fas fa-check-circle text-green-600"></i>
                            </div>
                            <div>
                                <p class="text-xs font-medium text-gray-600">Traités</p>
                                <p class="text-lg font-bold text-green-600">{{ entities|filter(e => e.instance.statut == 'traité')|length }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grille des cartes -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for entity in entities %}
                    <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden">
                        <!-- Header de la carte -->
                        <div class="p-6 border-b border-gray-200">
                            <div class="flex items-start justify-between mb-4">
                                <div class="flex-1">
                                    <h3 class="text-lg font-semibold text-gray-900 mb-2">{{ entity.instance.titre }}</h3>
                                    <p class="text-sm text-gray-600">{{ entity.instance.service.nom }}</p>
                                </div>
                                <div class="flex flex-col space-y-2">
                                    <!-- Badge niveau de risque -->
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium
                                        {% if entity.instance.niveauRisque == 'critique' %}bg-red-100 text-red-800
                                        {% elseif entity.instance.niveauRisque == 'élevé' %}bg-orange-100 text-orange-800
                                        {% elseif entity.instance.niveauRisque == 'moyen' %}bg-yellow-100 text-yellow-800
                                        {% else %}bg-green-100 text-green-800{% endif %}">
                                        <i class="fas fa-exclamation-triangle mr-1"></i>
                                        {{ entity.instance.niveauRisque|capitalize }}
                                    </span>
                                    
                                    <!-- Badge statut -->
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium
                                        {% if entity.instance.statut == 'en_cours' %}bg-blue-100 text-blue-800
                                        {% elseif entity.instance.statut == 'traité' %}bg-green-100 text-green-800
                                        {% elseif entity.instance.statut == 'surveillé' %}bg-yellow-100 text-yellow-800
                                        {% else %}bg-gray-100 text-gray-800{% endif %}">
                                        {% if entity.instance.statut == 'en_cours' %}<i class="fas fa-clock mr-1"></i>
                                        {% elseif entity.instance.statut == 'traité' %}<i class="fas fa-check mr-1"></i>
                                        {% elseif entity.instance.statut == 'surveillé' %}<i class="fas fa-eye mr-1"></i>
                                        {% else %}<i class="fas fa-archive mr-1"></i>{% endif %}
                                        {{ entity.instance.statut|replace({'_': ' '})|capitalize }}
                                    </span>
                                </div>
                            </div>
                            
                            <!-- Description -->
                            <p class="text-sm text-gray-700 line-clamp-3">{{ entity.instance.description|slice(0, 120) }}{% if entity.instance.description|length > 120 %}...{% endif %}</p>
                        </div>

                        <!-- Informations -->
                        <div class="p-6">
                            <div class="grid grid-cols-2 gap-4 text-sm mb-4">
                                <div>
                                    <span class="text-gray-500">Responsable:</span>
                                    <p class="font-medium text-gray-900">{{ entity.instance.responsable.nom }} {{ entity.instance.responsable.prenom }}</p>
                                </div>
                                <div>
                                    <span class="text-gray-500">Date détection:</span>
                                    <p class="font-medium text-gray-900">{{ entity.instance.dateDetection|date('d/m/Y') }}</p>
                                </div>
                                {% if entity.instance.scoreRisque %}
                                <div>
                                    <span class="text-gray-500">Score:</span>
                                    <p class="font-medium text-gray-900">{{ entity.instance.scoreRisque }}/25</p>
                                </div>
                                {% endif %}
                                {% if entity.instance.mesureEnCours %}
                                <div>
                                    <span class="text-gray-500">Mesure:</span>
                                    <p class="font-medium text-gray-900">
                                        {% if entity.instance.mesureMiseEnPlace %}
                                            <span class="text-green-600"><i class="fas fa-check mr-1"></i>En place</span>
                                        {% else %}
                                            <span class="text-yellow-600"><i class="fas fa-clock mr-1"></i>En cours</span>
                                        {% endif %}
                                    </p>
                                </div>
                                {% endif %}
                            </div>

                            <!-- Actions -->
                            <div class="flex space-x-2">
                                <a href="{{ ea_url().setAction('detail').setEntityId(entity.instance.id) }}" 
                                   class="flex-1 bg-blue-600 text-white px-3 py-2 rounded-md hover:bg-blue-700 transition-colors duration-300 text-center text-sm">
                                    <i class="fas fa-eye mr-1"></i>Voir
                                </a>
                                <a href="{{ ea_url().setAction('edit').setEntityId(entity.instance.id) }}" 
                                   class="flex-1 bg-green-600 text-white px-3 py-2 rounded-md hover:bg-green-700 transition-colors duration-300 text-center text-sm">
                                    <i class="fas fa-edit mr-1"></i>Modifier
                                </a>
                                <a href="/risque/{{ entity.instance.id }}"
                                   class="flex-1 bg-purple-600 text-white px-3 py-2 rounded-md hover:bg-purple-700 transition-colors duration-300 text-center text-sm">
                                    <i class="fas fa-external-link-alt mr-1"></i>Détail
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

        </div>
    </div>
{% endblock %}
