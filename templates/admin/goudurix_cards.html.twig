<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Risques - DUERP</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <!-- Navigation -->
    <nav class="bg-white shadow-sm border-b border-gray-200 mb-6">
        <div class="w-full px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center space-x-4">
                    {% if backUrl is defined %}
                    <a href="{{ backUrl }}" class="text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">
                        <i class="fas fa-arrow-left mr-1"></i>Retour
                    </a>
                    {% endif %}
                    <a href="/admin/goudurix-table" class="text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">
                        <i class="fas fa-home mr-1"></i>Administration
                    </a>
                    <a href="{{ path('admin') }}?crudAction=index&crudControllerFqcn=App%5CController%5CAdmin%5CGoudurixCrudController" 
                       class="bg-blue-50 text-blue-700 px-3 py-2 rounded-md text-sm font-medium">
                        <i class="fas fa-exclamation-triangle mr-1"></i>Risques
                    </a>
                    <a href="/goudurix-dashboard" 
                       class="text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">
                        <i class="fas fa-th-large mr-1"></i>Dashboard
                    </a>
                    <a href="/admin/retours-action" 
                       class="text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">
                        <i class="fas fa-comments mr-1"></i>Retours d'Action
                    </a>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="{{ path('import_csv_risques') }}" 
                       class="bg-green-500 text-white px-4 py-2 rounded-md hover:bg-green-600 transition-colors text-sm font-medium">
                        <i class="fas fa-file-import mr-1"></i>Importer CSV
                    </a>
                    <a href="{{ path('admin') }}?crudAction=new&crudControllerFqcn=App%5CController%5CAdmin%5CGoudurixCrudController" 
                       class="bg-indigo-500 text-white px-4 py-2 rounded-md hover:bg-indigo-600 transition-colors text-sm font-medium">
                        <i class="fas fa-plus mr-1"></i>Nouveau Risque
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <div class="content-wrapper" style="padding: 20px; width: 100%;">
        <!-- Header -->
        <div class="content-header" style="margin-bottom: 24px; width: 100%;">
            <div style="width: 100%; padding: 0 16px;">
                <h1 style="font-size: 1.875rem; font-weight: 700; color: #111827; margin: 0 0 8px 0;">
                    Gestion des risques
                </h1>
                <p style="font-size: 0.875rem; color: #4b5563; margin: 0;">
                    Interface de gestion des risques professionnels
                </p>
            </div>
        </div>

        <!-- Contenu principal -->
        <div style="min-height: 80vh; background: #f9fafb; padding: 24px; border-radius: 8px; width: 100%;">
            <div style="width: 100%;">
            
            <!-- Filtres -->
            <div class="bg-white rounded-lg shadow p-6 mb-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-4" style="display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-filter"></i>
                    Filtrer les risques
                </h2>
                <form id="filters-form" method="get" action="{{ formAction|default(path('admin')) }}" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; align-items: end;">
                    <input type="hidden" name="crudAction" value="index">
                    <input type="hidden" name="crudControllerFqcn" value="App\Controller\Admin\GoudurixCrudController">
                    <input type="hidden" name="menuIndex" value="0">
                    <input type="hidden" name="submenuIndex" value="-1">
                    
                    <div>
                        <label for="filter-niveauRisque" style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">
                            Niveau de Risque
                        </label>
                        <div style="position: relative;">
                            <select name="filters[niveauRisque]" id="filter-niveauRisque" style="width: 100%; padding: 0.625rem 2.5rem 0.625rem 0.875rem; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem; appearance: none; background-color: white;">
                                <option value="">Tous</option>
                                <option value="faible" {% if filters.niveauRisque is defined and filters.niveauRisque == 'faible' %}selected{% endif %}>Faible</option>
                                <option value="moyen" {% if filters.niveauRisque is defined and filters.niveauRisque == 'moyen' %}selected{% endif %}>Moyen</option>
                                <option value="élevé" {% if filters.niveauRisque is defined and filters.niveauRisque == 'élevé' %}selected{% endif %}>Élevé</option>
                                <option value="critique" {% if filters.niveauRisque is defined and filters.niveauRisque == 'critique' %}selected{% endif %}>Critique</option>
                            </select>
                            <i class="fas fa-chevron-down" style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); color: #6b7280; pointer-events: none;"></i>
                        </div>
                    </div>
                    
                    <div>
                        <label for="filter-statut" style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">
                            Statut
                        </label>
                        <div style="position: relative;">
                            <select name="filters[statut]" id="filter-statut" style="width: 100%; padding: 0.625rem 2.5rem 0.625rem 0.875rem; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem; appearance: none; background-color: white;">
                                <option value="">Tous</option>
                                <option value="en_cours" {% if filters.statut is defined and filters.statut == 'en_cours' %}selected{% endif %}>En cours</option>
                                <option value="traité" {% if filters.statut is defined and filters.statut == 'traité' %}selected{% endif %}>Traité</option>
                                <option value="surveillé" {% if filters.statut is defined and filters.statut == 'surveillé' %}selected{% endif %}>Surveillé</option>
                                <option value="archivé" {% if filters.statut is defined and filters.statut == 'archivé' %}selected{% endif %}>Archivé</option>
                            </select>
                            <i class="fas fa-chevron-down" style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); color: #6b7280; pointer-events: none;"></i>
                        </div>
                    </div>
                    
                    <div>
                        <label for="filter-service" style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">
                            Service
                        </label>
                        <div style="position: relative;">
                            <select name="filters[service]" id="filter-service" style="width: 100%; padding: 0.625rem 2.5rem 0.625rem 0.875rem; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem; appearance: none; background-color: white;">
                                <option value="">Tous</option>
                                {% if services is defined %}
                                    {% for service in services %}
                                        <option value="{{ service.id }}" {% if filters.service is defined and (filters.service == service.id or (filters.service is iterable and service.id in filters.service)) %}selected{% endif %}>
                                            {{ service.nom }}
                                        </option>
                                    {% endfor %}
                                {% endif %}
                            </select>
                            <i class="fas fa-chevron-down" style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); color: #6b7280; pointer-events: none;"></i>
                        </div>
                    </div>
                    
                    <div>
                        <label for="filter-responsable" style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">
                            Responsable
                        </label>
                        <div style="position: relative;">
                            <select name="filters[responsable]" id="filter-responsable" style="width: 100%; padding: 0.625rem 2.5rem 0.625rem 0.875rem; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem; appearance: none; background-color: white;">
                                <option value="">Tous</option>
                                {% if responsables is defined %}
                                    {% for responsable in responsables %}
                                        <option value="{{ responsable.id }}" {% if filters.responsable is defined and (filters.responsable == responsable.id or (filters.responsable is iterable and responsable.id in filters.responsable)) %}selected{% endif %}>
                                            {{ responsable.prenom }} {{ responsable.nom }}
                                        </option>
                                    {% endfor %}
                                {% endif %}
                            </select>
                            <i class="fas fa-chevron-down" style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); color: #6b7280; pointer-events: none;"></i>
                        </div>
                    </div>
                    
                    <div>
                        <label for="filter-lieu" style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">
                            Lieu
                        </label>
                        <div style="position: relative;">
                            <select name="filters[lieu]" id="filter-lieu" style="width: 100%; padding: 0.625rem 2.5rem 0.625rem 0.875rem; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem; appearance: none; background-color: white;">
                                <option value="">Tous</option>
                                {% if lieux is defined %}
                                    {% for lieu in lieux %}
                                        <option value="{{ lieu.id }}" {% if filters.lieu is defined and (filters.lieu == lieu.id or (filters.lieu is iterable and lieu.id in filters.lieu)) %}selected{% endif %}>
                                            {{ lieu.nom }}
                                        </option>
                                    {% endfor %}
                                {% endif %}
                            </select>
                            <i class="fas fa-chevron-down" style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); color: #6b7280; pointer-events: none;"></i>
                        </div>
                    </div>
                </form>
                
                <!-- Boutons de filtrage séparés -->
                <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 16px; flex-wrap: wrap;">
                    <button type="submit" form="filters-form" style="padding: 0.625rem 1.25rem; background-color: #3b82f6; color: white; border: none; border-radius: 0.375rem; font-weight: 500; font-size: 0.875rem; cursor: pointer; min-width: 120px; transition: background-color 0.2s;">
                        <i class="fas fa-search mr-1"></i>Filtrer
                    </button>
                    <a href="{{ (formAction is defined and formAction starts with '/') ? formAction : path('admin') }}" 
                       style="padding: 0.625rem 1.25rem; background-color: #6b7280; color: white; border: none; border-radius: 0.375rem; font-weight: 500; font-size: 0.875rem; cursor: pointer; text-decoration: none; display: inline-block; min-width: 120px; text-align: center; transition: background-color 0.2s;">
                        <i class="fas fa-times mr-1"></i>Réinitialiser
                    </a>
                    {% set exportUrl = path('goudurix_export_excel') %}
                    {% if filters is defined and filters|length > 0 %}
                        {% set exportUrl = exportUrl ~ '?' ~ app.request.queryString %}
                    {% endif %}
                    <a href="{{ exportUrl }}" 
                       style="padding: 0.625rem 1.25rem; background-color: #16a34a; color: white; border: none; border-radius: 0.375rem; font-weight: 500; font-size: 0.875rem; cursor: pointer; text-decoration: none; display: inline-block; min-width: 140px; text-align: center; transition: background-color 0.2s;">
                        <i class="fas fa-file-excel mr-1"></i>Exporter Excel
                    </a>
                </div>
            </div>
            
            <!-- Statistiques globales -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="bg-red-100 rounded-full p-2 mr-3">
                                <i class="fas fa-exclamation-triangle text-red-600"></i>
                            </div>
                            <div>
                                <p class="text-xs font-medium text-gray-600">Critiques</p>
                                <p class="text-lg font-bold text-red-600">
                                    {% if entities is defined %}
                                        {{ entities|filter(e => e.instance.niveauRisque == 'critique')|length }}
                                    {% else %}
                                        0
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="bg-orange-100 rounded-full p-2 mr-3">
                                <i class="fas fa-exclamation-circle text-orange-600"></i>
                            </div>
                            <div>
                                <p class="text-xs font-medium text-gray-600">Élevés</p>
                                <p class="text-lg font-bold text-orange-600">
                                    {% if entities is defined %}
                                        {{ entities|filter(e => e.instance.niveauRisque == 'élevé')|length }}
                                    {% else %}
                                        0
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="bg-blue-100 rounded-full p-2 mr-3">
                                <i class="fas fa-clock text-blue-600"></i>
                            </div>
                            <div>
                                <p class="text-xs font-medium text-gray-600">En Cours</p>
                                <p class="text-lg font-bold text-blue-600">
                                    {% if entities is defined %}
                                        {{ entities|filter(e => e.instance.statut == 'en_cours')|length }}
                                    {% else %}
                                        0
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="bg-green-100 rounded-full p-2 mr-3">
                                <i class="fas fa-check-circle text-green-600"></i>
                            </div>
                            <div>
                                <p class="text-xs font-medium text-gray-600">Traités</p>
                                <p class="text-lg font-bold text-green-600">
                                    {% if entities is defined %}
                                        {{ entities|filter(e => e.instance.statut == 'traité')|length }}
                                    {% else %}
                                        0
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grille des cartes -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                {% if entities is defined and entities|length > 0 %}
                    {% for entity in entities %}
                    <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden flex flex-col h-full">
                        <!-- Header de la carte -->
                        <div class="p-6 border-b border-gray-200 flex-shrink-0">
                            <div class="flex items-start justify-between mb-4">
                                <div class="flex-1">
                                    <h3 class="text-lg font-semibold text-gray-900 mb-2">{{ entity.instance.titre }}</h3>
                                    <p class="text-sm text-gray-600">{{ entity.instance.service.nom }}</p>
                                </div>
                                <div class="flex flex-col space-y-2 flex-shrink-0 ml-2">
                                    <!-- Badge niveau de risque -->
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium
                                        {% if entity.instance.niveauRisque == 'critique' %}bg-red-100 text-red-800
                                        {% elseif entity.instance.niveauRisque == 'élevé' %}bg-orange-100 text-orange-800
                                        {% elseif entity.instance.niveauRisque == 'moyen' %}bg-yellow-100 text-yellow-800
                                        {% else %}bg-green-100 text-green-800{% endif %}">
                                        <i class="fas fa-exclamation-triangle mr-1"></i>
                                        <span class="whitespace-nowrap">{{ entity.instance.niveauRisque|capitalize }}</span>
                                    </span>
                                    
                                    <!-- Badge statut -->
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium
                                        {% if entity.instance.statut == 'en_cours' %}bg-blue-100 text-blue-800
                                        {% elseif entity.instance.statut == 'traité' %}bg-green-100 text-green-800
                                        {% elseif entity.instance.statut == 'surveillé' %}bg-yellow-100 text-yellow-800
                                        {% else %}bg-gray-100 text-gray-800{% endif %}">
                                        {% if entity.instance.statut == 'en_cours' %}<i class="fas fa-clock mr-1"></i>
                                        {% elseif entity.instance.statut == 'traité' %}<i class="fas fa-check mr-1"></i>
                                        {% elseif entity.instance.statut == 'surveillé' %}<i class="fas fa-eye mr-1"></i>
                                        {% else %}<i class="fas fa-archive mr-1"></i>{% endif %}
                                        <span class="whitespace-nowrap">{{ entity.instance.statut|replace({'_': ' '})|capitalize }}</span>
                                    </span>
                                </div>
                            </div>
                            
                            <!-- Description -->
                            <p class="text-sm text-gray-700 line-clamp-3 min-h-[3.75rem]">{{ entity.instance.description|slice(0, 120) }}{% if entity.instance.description|length > 120 %}...{% endif %}</p>
                        </div>

                        <!-- Informations -->
                        <div class="p-6 flex-grow flex flex-col">
                            <div class="grid grid-cols-2 gap-4 text-sm mb-4 flex-grow">
                                <div>
                                    <span class="text-gray-500 block mb-1">Responsable:</span>
                                    <p class="font-medium text-gray-900 truncate">{{ entity.instance.responsable.nom }} {{ entity.instance.responsable.prenom }}</p>
                                </div>
                                <div>
                                    <span class="text-gray-500 block mb-1">Date détection:</span>
                                    <p class="font-medium text-gray-900">{{ entity.instance.dateDetection|date('d/m/Y') }}</p>
                                </div>
                                {% if entity.instance.scoreRisque %}
                                <div>
                                    <span class="text-gray-500 block mb-1">Score:</span>
                                    <p class="font-medium text-gray-900">{{ entity.instance.scoreRisque }}/25</p>
                                </div>
                                {% endif %}
                                {% if entity.instance.mesureEnCours %}
                                <div>
                                    <span class="text-gray-500 block mb-1">Mesure:</span>
                                    <p class="font-medium text-gray-900">
                                        {% if entity.instance.mesureMiseEnPlace %}
                                            <span class="text-green-600"><i class="fas fa-check mr-1"></i>En place</span>
                                        {% else %}
                                            <span class="text-yellow-600"><i class="fas fa-clock mr-1"></i>En cours</span>
                                        {% endif %}
                                    </p>
                                </div>
                                {% else %}
                                <div></div>
                                {% endif %}
                            </div>

                            <!-- Actions - Toujours alignées en bas -->
                            <div class="flex flex-col sm:flex-row gap-2 mt-auto">
                                <a href="{{ entity.detailUrl }}" 
                                   class="flex-1 bg-indigo-500 text-white px-3 py-2 rounded-md hover:bg-indigo-600 transition-colors duration-300 text-center text-sm flex items-center justify-center shadow-sm">
                                    <i class="fas fa-info-circle mr-1"></i><span class="whitespace-nowrap">Détail</span>
                                </a>
                                <a href="{{ entity.editUrl }}" 
                                   class="flex-1 bg-teal-500 text-white px-3 py-2 rounded-md hover:bg-teal-600 transition-colors duration-300 text-center text-sm flex items-center justify-center shadow-sm">
                                    <i class="fas fa-edit mr-1"></i><span class="whitespace-nowrap">Modifier</span>
                                </a>
                                <a href="{{ entity.deleteUrl }}" 
                                   class="flex-1 bg-rose-500 text-white px-3 py-2 rounded-md hover:bg-rose-600 transition-colors duration-300 text-center text-sm flex items-center justify-center shadow-sm"
                                   onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce risque ?');">
                                    <i class="fas fa-trash mr-1"></i><span class="whitespace-nowrap">Supprimer</span>
                                </a>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                {% else %}
                    <div class="col-span-full text-center py-12">
                        <p class="text-gray-500 text-lg">Aucun risque trouvé</p>
                    </div>
                {% endif %}
            </div>

            </div>
        </div>
    </div>
</body>
</html>
