{% extends 'base.html.twig' %}

{% block title %}Détail du Risque - {{ risque.titre }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Messages flash -->
        {% for message in app.flashes('success') %}
        <div class="mb-4 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">{{ message }}</span>
        </div>
        {% endfor %}

        <!-- Header -->
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">{{ risque.titre }}</h1>
                    <p class="text-lg text-gray-600 mt-2">{{ risque.service.nom }}</p>
                </div>
                <div class="flex space-x-4">
                    <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium
                        {% if risque.niveauRisque == 'critique' %}bg-red-100 text-red-800
                        {% elseif risque.niveauRisque == 'élevé' %}bg-orange-100 text-orange-800
                        {% elseif risque.niveauRisque == 'moyen' %}bg-yellow-100 text-yellow-800
                        {% else %}bg-green-100 text-green-800{% endif %}">
                        {{ risque.niveauRisque|capitalize }}
                    </span>
                    <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium
                        {% if risque.statut == 'en_cours' %}bg-blue-100 text-blue-800
                        {% elseif risque.statut == 'traité' %}bg-green-100 text-green-800
                        {% elseif risque.statut == 'surveillé' %}bg-yellow-100 text-yellow-800
                        {% else %}bg-gray-100 text-gray-800{% endif %}">
                        {{ risque.statut|replace({'_': ' '})|capitalize }}
                    </span>
                </div>
            </div>
        </div>

        <!-- Informations principales -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Description -->
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Description du Risque</h2>
                <p class="text-gray-700 leading-relaxed">{{ risque.description }}</p>
            </div>

            <!-- Informations -->
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Informations</h2>
                <dl class="space-y-3">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Date de détection</dt>
                        <dd class="text-gray-900">{{ risque.dateDetection|date('d/m/Y') }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Responsable</dt>
                        <dd class="text-gray-900">{{ risque.responsable.nom }} {{ risque.responsable.prenom }}</dd>
                    </div>
                    {% if risque.dateResolution %}
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Date de résolution</dt>
                        <dd class="text-gray-900">{{ risque.dateResolution|date('d/m/Y') }}</dd>
                    </div>
                    {% endif %}
                    {% if risque.scoreRisque %}
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Score de risque</dt>
                        <dd class="text-gray-900">{{ risque.scoreRisque }}/25</dd>
                    </div>
                    {% endif %}
                </dl>
            </div>
        </div>

        <!-- Mesures et Retours d'Action -->
        <div class="mt-8">
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-6">Mesures et Suivi</h2>
                
                <!-- Mesure en cours -->
                <div class="mb-6">
                    <h3 class="text-lg font-medium text-gray-900 mb-3">Mesure en Cours</h3>
                    
                    {% if risque.mesureEnCours %}
                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
                        <p class="text-blue-900 mb-3">{{ risque.mesureEnCours }}</p>
                        <div class="flex items-center justify-between">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium
                                {% if risque.mesureMiseEnPlace %}bg-green-100 text-green-800{% else %}bg-yellow-100 text-yellow-800{% endif %}">
                                {% if risque.mesureMiseEnPlace %}✓ Mise en place{% else %}⏳ En cours{% endif %}
                            </span>
                        </div>
                    </div>
                    {% endif %}

                    <!-- Formulaire pour ajouter/modifier une mesure -->
                    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                        <h4 class="text-md font-medium text-gray-900 mb-3">Ajouter/Modifier une Mesure</h4>
                        <form action="{{ path('risque_add_mesure', {'id': risque.id}) }}" method="POST" class="space-y-4">
                            <div>
                                <label for="mesure_en_cours" class="block text-sm font-medium text-gray-700 mb-2">Description de la mesure</label>
                                <textarea id="mesure_en_cours" name="mesure_en_cours" rows="3" 
                                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                                    placeholder="Décrivez la mesure préventive ou corrective...">{{ risque.mesureEnCours ?? '' }}</textarea>
                            </div>
                            <div class="flex items-center">
                                <input type="checkbox" id="mesure_mise_en_place" name="mesure_mise_en_place" 
                                    {% if risque.mesureMiseEnPlace %}checked{% endif %}
                                    class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                                <label for="mesure_mise_en_place" class="ml-2 block text-sm text-gray-700">
                                    Mesure effectivement mise en place
                                </label>
                            </div>
                            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors duration-300">
                                <i class="fas fa-save mr-2"></i>Sauvegarder la Mesure
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Retour d'action -->
                <div class="mb-6">
                    <h3 class="text-lg font-medium text-gray-900 mb-3">Retour d'Action</h3>
                    
                    {% if risque.retourAction %}
                    <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
                        <p class="text-green-900 mb-3">{{ risque.retourAction }}</p>
                        <div class="flex items-center justify-between text-sm text-green-700">
                            <span>
                                {% if risque.auteurRetour %}
                                    Par {{ risque.auteurRetour.nom }} {{ risque.auteurRetour.prenom }}
                                {% endif %}
                            </span>
                            <span>
                                {% if risque.dateRetour %}
                                    Le {{ risque.dateRetour|date('d/m/Y à H:i') }}
                                {% endif %}
                            </span>
                        </div>
                    </div>
                    {% endif %}

                    <!-- Formulaire pour ajouter un retour d'action -->
                    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                        <h4 class="text-md font-medium text-gray-900 mb-3">Ajouter un Retour d'Action</h4>
                        <form action="{{ path('risque_add_retour', {'id': risque.id}) }}" method="POST" class="space-y-4">
                            <div>
                                <label for="retour_action" class="block text-sm font-medium text-gray-700 mb-2">Retour d'action</label>
                                <textarea id="retour_action" name="retour_action" rows="3" 
                                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
                                    placeholder="Décrivez les actions mises en place..."></textarea>
                            </div>
                            <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 transition-colors duration-300">
                                <i class="fas fa-comment mr-2"></i>Ajouter le Retour
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Mise à jour du statut -->
                <div class="mb-6">
                    <h3 class="text-lg font-medium text-gray-900 mb-3">Mise à Jour du Statut</h3>
                    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                        <h4 class="text-md font-medium text-gray-900 mb-3">Modifier le Statut</h4>
                        <form action="{{ path('risque_update_statut', {'id': risque.id}) }}" method="POST" class="space-y-4">
                            <div>
                                <label for="statut" class="block text-sm font-medium text-gray-700 mb-2">Nouveau statut</label>
                                <select id="statut" name="statut" 
                                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                                    <option value="en_cours" {% if risque.statut == 'en_cours' %}selected{% endif %}>En Cours</option>
                                    <option value="traité" {% if risque.statut == 'traité' %}selected{% endif %}>Traité</option>
                                    <option value="surveillé" {% if risque.statut == 'surveillé' %}selected{% endif %}>Surveillé</option>
                                    <option value="archivé" {% if risque.statut == 'archivé' %}selected{% endif %}>Archivé</option>
                                </select>
                            </div>
                            <div>
                                <label for="date_resolution" class="block text-sm font-medium text-gray-700 mb-2">Date de résolution (si traité)</label>
                                <input type="date" id="date_resolution" name="date_resolution" 
                                    value="{% if risque.dateResolution %}{{ risque.dateResolution|date('Y-m-d') }}{% endif %}"
                                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                            </div>
                            <button type="submit" class="bg-purple-600 text-white px-4 py-2 rounded-md hover:bg-purple-700 transition-colors duration-300">
                                <i class="fas fa-check mr-2"></i>Mettre à Jour le Statut
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex space-x-4">
                    <a href="/admin/goudurix/{{ risque.id }}/edit" 
                       class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors duration-300">
                        <i class="fas fa-edit mr-2"></i>Modifier le Risque
                    </a>
                    <a href="/goudurix-dashboard" 
                       class="bg-gray-600 text-white px-4 py-2 rounded-md hover:bg-gray-700 transition-colors duration-300">
                        <i class="fas fa-arrow-left mr-2"></i>Retour au Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
