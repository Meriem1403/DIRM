{% extends 'base.html.twig' %}

{% block title %}Détail du Risque - {{ risque.titre }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Messages flash -->
        {% for message in app.flashes('success') %}
        <div class="mb-4 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">{{ message }}</span>
        </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
        <div class="mb-4 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">{{ message }}</span>
        </div>
        {% endfor %}
        {% for message in app.flashes('warning') %}
        <div class="mb-4 bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">{{ message }}</span>
        </div>
        {% endfor %}

        <!-- Header -->
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">{{ risque.titre }}</h1>
                    <p class="text-lg text-gray-600 mt-2">{{ risque.service.nom }}</p>
                </div>
                <div class="flex space-x-4">
                    <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium
                        {% if risque.niveauRisque == 'critique' %}bg-red-100 text-red-800
                        {% elseif risque.niveauRisque == 'élevé' %}bg-orange-100 text-orange-800
                        {% elseif risque.niveauRisque == 'moyen' %}bg-yellow-100 text-yellow-800
                        {% else %}bg-green-100 text-green-800{% endif %}">
                        {{ risque.niveauRisque|capitalize }}
                    </span>
                    <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium
                        {% if risque.statut == 'en_cours' %}bg-blue-100 text-blue-800
                        {% elseif risque.statut == 'traité' %}bg-green-100 text-green-800
                        {% elseif risque.statut == 'surveillé' %}bg-yellow-100 text-yellow-800
                        {% else %}bg-gray-100 text-gray-800{% endif %}">
                        {{ risque.statut|replace({'_': ' '})|capitalize }}
                    </span>
                    
                    {% if 'ROLE_ADMIN' in app.user.roles and not risque.mesureEnCours %}
                    <button onclick="toggleMesureForm()" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors duration-300">
                        <i class="fas fa-plus mr-2"></i>Ajouter une mesure
                    </button>
                    {% endif %}
                    <a href="{{ path('mes_risques') }}" style="background-color: #4b5563 !important; color: #ffffff !important; padding: 10px 16px; border-radius: 6px; text-decoration: none; font-weight: bold; display: inline-flex; align-items: center;"
                       onmouseover="this.style.backgroundColor='#374151'" onmouseout="this.style.backgroundColor='#4b5563'">
                        <i class="fas fa-arrow-left mr-2"></i>Retour
                    </a>
                </div>
            </div>
        </div>

        <!-- Informations principales -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Description -->
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Description</h2>
                <p class="text-gray-700 leading-relaxed">{{ risque.description }}</p>
            </div>

            <!-- Informations -->
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Informations</h2>
                <dl class="space-y-3">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Date de détection</dt>
                        <dd class="text-gray-900">{{ risque.dateDetection|date('d/m/Y') }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Responsable</dt>
                        <dd class="text-gray-900">{{ risque.responsable.nom }} {{ risque.responsable.prenom }}</dd>
                    </div>
                    {% if risque.dateResolution %}
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Date de résolution</dt>
                        <dd class="text-gray-900">{{ risque.dateResolution|date('d/m/Y') }}</dd>
                    </div>
                    {% endif %}
                    {% if risque.scoreRisque %}
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Score de risque</dt>
                        <dd class="text-gray-900">{{ risque.scoreRisque }}/25</dd>
                    </div>
                    {% endif %}
                </dl>
            </div>
        </div>

        <!-- Mesures -->
        <div class="mt-8">
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-6">Mesure</h2>
                
                {% if risque.mesureEnCours %}
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
                    <p class="text-blue-900 mb-3">{{ risque.mesureEnCours }}</p>
                    <div class="flex items-center justify-between">
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium
                            {% if risque.mesureMiseEnPlace %}bg-green-100 text-green-800{% else %}bg-yellow-100 text-yellow-800{% endif %}">
                            {% if risque.mesureMiseEnPlace %}✓ Mise en place{% else %}⏳ En cours{% endif %}
                        </span>
                    </div>
                </div>
                {% else %}
                <p class="text-gray-500">Aucune mesure définie pour ce risque.</p>
                {% endif %}

                <!-- Retours d'action -->
                {% if risque.retoursAction|length > 0 %}
                <div class="bg-white rounded-lg shadow p-6 mt-8">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">
                        <i class="fas fa-comments mr-2"></i>Retours d'action
                    </h2>
                    <div class="space-y-4">
                        {% for retour in risque.retoursAction %}
                        <div class="border border-gray-200 rounded-lg p-4">
                            <div class="flex justify-between items-start mb-2">
                                <div>
                                    <p class="font-medium text-gray-900">{{ retour.auteur.prenom }} {{ retour.auteur.nom }}</p>
                                    <p class="text-sm text-gray-500">
                                        <i class="fas fa-calendar mr-1"></i>
                                        {{ retour.dateCreation|date('d/m/Y à H:i') }}
                                    </p>
                                </div>
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium
                                    {% if retour.statut == 'validé' %}bg-green-100 text-green-800
                                    {% elseif retour.statut == 'refusé' %}bg-red-100 text-red-800
                                    {% else %}bg-yellow-100 text-yellow-800{% endif %}">
                                    {% if retour.statut == 'validé' %}<i class="fas fa-check mr-1"></i>Validé
                                    {% elseif retour.statut == 'refusé' %}<i class="fas fa-times mr-1"></i>Refusé
                                    {% else %}<i class="fas fa-clock mr-1"></i>En attente{% endif %}
                                </span>
                            </div>
                            
                            <p class="text-gray-700 mb-3">{{ retour.description }}</p>
                            
                            {% if retour.commentaireValidation %}
                            <div class="mt-3 p-3 bg-gray-50 rounded text-sm">
                                <strong>Commentaire :</strong> {{ retour.commentaireValidation }}
                            </div>
                            {% endif %}
                            
                            {% if 'ROLE_ADMIN' in app.user.roles and retour.statut == 'en_attente' %}
                            <div class="mt-4 pt-4 border-t border-gray-200">
                                <form action="{{ path('admin_valider_retour', {'id': retour.id}) }}" method="POST" class="space-y-4">
                                    <div>
                                        <textarea name="commentaire" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                                            placeholder="Commentaire (optionnel)"></textarea>
                                    </div>
                                    <div class="flex flex-wrap justify-end gap-3">
                                        <button type="submit" name="action" value="remplacer" 
                                            style="background-color: #2563eb !important; color: #ffffff !important; padding: 10px 16px; border-radius: 6px; border: none; cursor: pointer; font-weight: bold; margin-left: 8px;"
                                            onmouseover="this.style.backgroundColor='#1d4ed8'" onmouseout="this.style.backgroundColor='#2563eb'">
                                            <i class="fas fa-exchange-alt mr-1"></i>Remplacer la mesure
                                        </button>
                                        <button type="submit" name="action" value="completer" 
                                            style="background-color: #16a34a !important; color: #ffffff !important; padding: 10px 16px; border-radius: 6px; border: none; cursor: pointer; font-weight: bold; margin-left: 8px;"
                                            onmouseover="this.style.backgroundColor='#15803d'" onmouseout="this.style.backgroundColor='#16a34a'">
                                            <i class="fas fa-plus-circle mr-1"></i>Compléter la mesure
                                        </button>
                                        <button type="submit" name="action" value="refuser" 
                                            style="background-color: #dc2626 !important; color: #ffffff !important; padding: 10px 16px; border-radius: 6px; border: none; cursor: pointer; font-weight: bold; margin-left: 8px;"
                                            onmouseover="this.style.backgroundColor='#b91c1c'" onmouseout="this.style.backgroundColor='#dc2626'">
                                            <i class="fas fa-times mr-1"></i>Refuser
                                        </button>
                                    </div>
                                </form>
                            </div>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Formulaire pour ajouter une mesure (admin seulement) -->
        {% if 'ROLE_ADMIN' in app.user.roles and not risque.mesureEnCours %}
        <div id="mesureForm" class="mt-8 bg-white rounded-lg shadow p-6" style="display: none;">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">
                <i class="fas fa-plus mr-2"></i>Ajouter une mesure
            </h2>
            <form action="{{ path('risque_add_mesure', {'id': risque.id}) }}" method="POST" class="space-y-4">
                <div>
                    <label for="mesure_en_cours" class="block text-sm font-medium text-gray-700 mb-2">
                        Description de la mesure
                    </label>
                    <textarea id="mesure_en_cours" name="mesure_en_cours" rows="4" 
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="Décrivez la mesure préventive ou corrective à mettre en place..."
                        required></textarea>
                </div>
                <div class="flex items-center">
                    <input type="checkbox" id="mesure_mise_en_place" name="mesure_mise_en_place" 
                        class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                    <label for="mesure_mise_en_place" class="ml-2 block text-sm text-gray-700">
                        Mesure déjà mise en place
                    </label>
                </div>
                <div class="flex space-x-4">
                    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors duration-300">
                        <i class="fas fa-save mr-2"></i>Enregistrer
                    </button>
                    <button type="button" onclick="toggleMesureForm()" class="bg-gray-600 text-white px-4 py-2 rounded-md hover:bg-gray-700 transition-colors duration-300">
                        <i class="fas fa-times mr-2"></i>Annuler
                    </button>
                </div>
            </form>
        </div>
        {% endif %}

        <!-- Formulaire de retour d'action pour les chefs -->
        {% if 'ROLE_CHEF' in app.user.roles %}
        <div class="mt-8 bg-green-50 border border-green-300 rounded-lg shadow p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">
                <i class="fas fa-comment mr-2"></i>Retour d'action
            </h2>
            {% if not risque.mesureEnCours %}
            <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded">
                Aucune mesure n'est actuellement en cours pour ce risque. Contactez un administrateur pour ajouter une mesure.
            </div>
            {% else %}
            <form action="{{ path('risque_add_retour_action', {'id': risque.id}) }}" method="POST" class="space-y-4">
                <div>
                    <textarea id="description_securite" name="description" rows="6" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500"
                        placeholder="Décrivez en détail les actions que vous avez mises en place pour traiter ce risque..."
                        required></textarea>
                </div>
                <div class="mt-6">
                    <button type="submit" style="width: 100%; background-color: #16a34a !important; color: #ffffff !important; padding: 16px 32px; border-radius: 8px; font-weight: bold; font-size: 18px; border: none; cursor: pointer;" onmouseover="this.style.backgroundColor='#15803d'" onmouseout="this.style.backgroundColor='#16a34a'">
                        <i class="fas fa-paper-plane mr-2"></i>Envoyer
                    </button>
                </div>
            </form>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>

<script>
function toggleMesureForm() {
    const form = document.getElementById('mesureForm');
    if (form && form.style.display === 'none') {
        form.style.display = 'block';
        form.scrollIntoView({ behavior: 'smooth' });
    } else if (form) {
        form.style.display = 'none';
    }
}
</script>
{% endblock %}
