<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Résultat de l'import CSV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <div class="container mx-auto px-4 py-8">
        <div class="bg-white rounded-lg shadow-lg p-6">
            <h1 class="text-3xl font-bold mb-6 text-gray-800">
                <i class="fas fa-file-import mr-2"></i>Résultat de l'import CSV
            </h1>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <div class="flex items-center">
                        <i class="fas fa-list text-blue-600 text-2xl mr-3"></i>
                        <div>
                            <p class="text-sm text-gray-600">Total lignes</p>
                            <p class="text-2xl font-bold text-blue-600">{{ stats.total }}</p>
                        </div>
                    </div>
                </div>

                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle text-green-600 text-2xl mr-3"></i>
                        <div>
                            <p class="text-sm text-gray-600">Importés</p>
                            <p class="text-2xl font-bold text-green-600">{{ stats.imported }}</p>
                        </div>
                    </div>
                </div>

                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-triangle text-yellow-600 text-2xl mr-3"></i>
                        <div>
                            <p class="text-sm text-gray-600">Ignorés</p>
                            <p class="text-2xl font-bold text-yellow-600">{{ stats.skipped }}</p>
                        </div>
                    </div>
                </div>
            </div>

            {% if stats.errors|length > 0 %}
            <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                <h2 class="text-lg font-semibold text-red-800 mb-3">
                    <i class="fas fa-exclamation-circle mr-2"></i>Erreurs ({{ stats.errors|length }})
                </h2>
                <div class="max-h-64 overflow-y-auto">
                    <ul class="list-disc list-inside space-y-1">
                        {% for error in stats.errors|slice(0, 50) %}
                            <li class="text-sm text-red-700">{{ error }}</li>
                        {% endfor %}
                        {% if stats.errors|length > 50 %}
                            <li class="text-sm text-red-600 italic">... et {{ stats.errors|length - 50 }} autres erreurs</li>
                        {% endif %}
                    </ul>
                </div>
            </div>
            {% endif %}

            <div class="flex gap-4">
                <a href="{{ path('goudurix_front') }}" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i>Retour aux risques
                </a>
                <a href="{{ path('admin') }}" class="bg-gray-600 text-white px-6 py-2 rounded-lg hover:bg-gray-700 transition-colors">
                    <i class="fas fa-home mr-2"></i>Administration
                </a>
            </div>
        </div>
    </div>
</body>
</html>

