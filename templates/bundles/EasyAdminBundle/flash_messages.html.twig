{# templates/bundles/EasyAdminBundle/flash_messages.html.twig #}
<style>
    /* Force la couleur des boutons submit dans EasyAdmin */
    .ea-content-footer button[type="submit"],
    .ea-content-footer button[type="submit"]:not(:hover),
    form button[type="submit"],
    form button[type="submit"]:not(:hover),
    button.ea-btn-primary:not(:hover),
    .ea-action-save:not(:hover) {
        background-color: #3b82f6 !important;
        color: #ffffff !important;
        border-color: #3b82f6 !important;
        background: #3b82f6 !important;
    }
</style>

{% set flash_messages = ea.context %}

{% if flash_messages|length > 0 %}
    <div id="flash-messages">
        {% for type, messages in flash_messages %}
            {# “error” → “danger” pour Bootstrap, sinon on garde le type #}
            {% set variant = (type == 'error') ? 'danger' : type %}

            {% for message in messages %}
                <div class="alert alert-{{ variant }} alert-dismissible fade show" role="alert">
                    {{ message|trans|raw }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}
