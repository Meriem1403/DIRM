{% extends 'base.html.twig' %}

{% block title %}Comprendre les risques{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .risks-container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        .page-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            padding: 32px;
            margin-bottom: 32px;
            color: white;
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.3);
        }

        .page-header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0 0 8px 0;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .page-header p {
            font-size: 1.1rem;
            opacity: 0.9;
            margin: 0;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: rgba(255, 255, 255, 0.2);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: background 0.2s;
            margin-bottom: 20px;
        }

        .back-button:hover {
            background: rgba(255, 255, 255, 0.3);
            color: white;
        }

        .risks-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 24px;
        }

        @media (max-width: 768px) {
            .risks-list {
                grid-template-columns: 1fr;
            }
        }

        .risk-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 24px;
            transition: all 0.3s;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

        .risk-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
            border-color: #667eea;
        }

        .risk-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 16px;
        }

        .risk-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #111827;
            margin: 0 0 8px 0;
            line-height: 1.4;
        }

        .badges-container {
            display: flex;
            flex-direction: column;
            gap: 8px;
            align-items: flex-end;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .badge i {
            font-size: 12px;
        }

        .badge-critique {
            background-color: #fef2f2;
            color: #dc2626;
        }

        .badge-eleve {
            background-color: #fff7ed;
            color: #ea580c;
        }

        .badge-moyen {
            background-color: #fefce8;
            color: #ca8a04;
        }

        .badge-faible {
            background-color: #f0fdf4;
            color: #16a34a;
        }

        .badge-en-cours {
            background-color: #eff6ff;
            color: #2563eb;
        }

        .badge-traite {
            background-color: #f0fdf4;
            color: #16a34a;
        }

        .badge-surveille {
            background-color: #fefce8;
            color: #ca8a04;
        }

        .badge-archive {
            background-color: #f3f4f6;
            color: #374151;
        }

        .risk-description {
            font-size: 14px;
            color: #6b7280;
            line-height: 1.6;
            margin-bottom: 16px;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .risk-meta {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            padding-top: 16px;
            border-top: 1px solid #e5e7eb;
            margin-bottom: 16px;
        }

        .risk-meta-item {
            display: flex;
            flex-direction: column;
        }

        .risk-meta-label {
            font-size: 11px;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .risk-meta-value {
            font-size: 14px;
            color: #111827;
            font-weight: 600;
        }

        .risk-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 16px;
            border-top: 1px solid #e5e7eb;
        }

        .risk-service {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #6b7280;
        }

        .view-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            background: #667eea;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            transition: background 0.2s;
        }

        .view-link:hover {
            background: #5568d3;
            color: white;
        }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
            background: white;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
        }

        .empty-state-icon {
            font-size: 5rem;
            color: #d1d5db;
            margin-bottom: 24px;
        }

        .empty-state-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #111827;
            margin-bottom: 8px;
        }

        .empty-state-text {
            color: #6b7280;
            font-size: 1rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="risks-container">
    <a href="{{ path('mes_risques') }}" class="back-button">
        <i class="fas fa-arrow-left"></i>
        Retour à Mes Risques
    </a>

    <div class="page-header">
        <h1>
            <i class="fas fa-book-reader"></i>
            Comprendre les risques
        </h1>
        <p>Explorez les fiches détaillées de tous les risques enregistrés dans le système</p>
    </div>

    {% if risques|length > 0 %}
        <div class="risks-list">
            {% for risque in risques %}
            <div class="risk-card" onclick="window.location.href='{{ path('comprendre_risques_detail', {id: risque.id}) }}'">
                <div class="risk-card-header">
                    <h3 class="risk-title">{{ risque.titre }}</h3>
                    <div class="badges-container">
                        {% set niveauClass = 'faible' %}
                        {% if risque.niveauRisque == 'critique' %}
                            {% set niveauClass = 'critique' %}
                        {% elseif risque.niveauRisque == 'élevé' %}
                            {% set niveauClass = 'eleve' %}
                        {% elseif risque.niveauRisque == 'moyen' %}
                            {% set niveauClass = 'moyen' %}
                        {% endif %}
                        <span class="badge badge-{{ niveauClass }}">
                            <i class="fas fa-exclamation-triangle"></i>
                            {{ risque.niveauRisque|capitalize }}
                        </span>
                        {% set statutClass = 'en-cours' %}
                        {% if risque.statut == 'en_cours' %}
                            {% set statutClass = 'en-cours' %}
                        {% elseif risque.statut == 'traité' %}
                            {% set statutClass = 'traite' %}
                        {% elseif risque.statut == 'surveillé' %}
                            {% set statutClass = 'surveille' %}
                        {% else %}
                            {% set statutClass = 'archive' %}
                        {% endif %}
                        <span class="badge badge-{{ statutClass }}">
                            {% if risque.statut == 'en_cours' %}<i class="fas fa-clock"></i>
                            {% elseif risque.statut == 'traité' %}<i class="fas fa-check"></i>
                            {% elseif risque.statut == 'surveillé' %}<i class="fas fa-eye"></i>
                            {% else %}<i class="fas fa-archive"></i>{% endif %}
                            {{ risque.statut|replace({'_': ' '})|capitalize }}
                        </span>
                    </div>
                </div>

                <p class="risk-description">{{ risque.description }}</p>

                <div class="risk-meta">
                    <div class="risk-meta-item">
                        <span class="risk-meta-label">Responsable</span>
                        <span class="risk-meta-value">{{ risque.responsable.prenom }} {{ risque.responsable.nom }}</span>
                    </div>
                    <div class="risk-meta-item">
                        <span class="risk-meta-label">Date de détection</span>
                        <span class="risk-meta-value">{{ risque.dateDetection|date('d/m/Y') }}</span>
                    </div>
                </div>

                {% if risque.scoreRisque %}
                <div class="risk-meta" style="margin-top: 0;">
                    <div class="risk-meta-item">
                        <span class="risk-meta-label">Score de risque</span>
                        <span class="risk-meta-value">{{ risque.scoreRisque }}/25</span>
                    </div>
                </div>
                {% endif %}

                <div class="risk-footer">
                    <div class="risk-service">
                        <i class="fas fa-building"></i>
                        <span>{{ risque.service.nom }}</span>
                    </div>
                    <a href="{{ path('comprendre_risques_detail', {id: risque.id}) }}" class="view-link" onclick="event.stopPropagation()">
                        Voir la fiche
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-inbox"></i>
            </div>
            <h3 class="empty-state-title">Aucun risque enregistré</h3>
            <p class="empty-state-text">Il n'y a actuellement aucun risque dans le système.</p>
        </div>
    {% endif %}
</div>
{% endblock %}
