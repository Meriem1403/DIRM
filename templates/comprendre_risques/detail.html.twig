{% extends 'base.html.twig' %}

{% block title %}Fiche risque - {{ risque.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .risk-detail-container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: #667eea;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: background 0.2s;
            margin-bottom: 24px;
        }

        .back-button:hover {
            background: #5568d3;
            color: white;
        }

        .risk-detail-card {
            background: white;
            border-radius: 16px;
            padding: 32px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
            border: 1px solid #e5e7eb;
        }

        .risk-header {
            border-bottom: 2px solid #e5e7eb;
            padding-bottom: 24px;
            margin-bottom: 32px;
        }

        .risk-header-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 16px;
        }

        .risk-title {
            font-size: 2rem;
            font-weight: 700;
            color: #111827;
            margin: 0;
            line-height: 1.3;
        }

        .risk-badges {
            display: flex;
            flex-direction: column;
            gap: 8px;
            align-items: flex-end;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        .badge i {
            font-size: 14px;
        }

        .badge-critique {
            background-color: #fef2f2;
            color: #dc2626;
        }

        .badge-eleve {
            background-color: #fff7ed;
            color: #ea580c;
        }

        .badge-moyen {
            background-color: #fefce8;
            color: #ca8a04;
        }

        .badge-faible {
            background-color: #f0fdf4;
            color: #16a34a;
        }

        .badge-en-cours {
            background-color: #eff6ff;
            color: #2563eb;
        }

        .badge-traite {
            background-color: #f0fdf4;
            color: #16a34a;
        }

        .badge-surveille {
            background-color: #fefce8;
            color: #ca8a04;
        }

        .badge-archive {
            background-color: #f3f4f6;
            color: #374151;
        }

        .risk-meta-bar {
            display: flex;
            gap: 24px;
            flex-wrap: wrap;
            margin-top: 16px;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: #6b7280;
        }

        .meta-item i {
            color: #9ca3af;
        }

        .risk-section {
            margin-bottom: 32px;
        }

        .risk-section:last-child {
            margin-bottom: 0;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #111827;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 12px;
            border-bottom: 2px solid #f3f4f6;
        }

        .section-title i {
            color: #667eea;
        }

        .section-content {
            font-size: 15px;
            color: #374151;
            line-height: 1.7;
        }

        .section-content p {
            margin: 0 0 12px 0;
        }

        .section-content p:last-child {
            margin-bottom: 0;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 16px;
        }

        .info-card {
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 20px;
        }

        .info-label {
            font-size: 12px;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .info-value {
            font-size: 16px;
            color: #111827;
            font-weight: 600;
        }

        .score-display {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 12px;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .mesures-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .mesures-list li {
            padding: 12px 16px;
            background: #f9fafb;
            border-left: 4px solid #667eea;
            border-radius: 6px;
            margin-bottom: 12px;
            font-size: 14px;
            color: #374151;
        }

        .mesures-list li:last-child {
            margin-bottom: 0;
        }

        .empty-content {
            color: #9ca3af;
            font-style: italic;
            padding: 16px;
            background: #f9fafb;
            border-radius: 8px;
            text-align: center;
        }

        @media (max-width: 768px) {
            .risk-detail-card {
                padding: 20px;
            }

            .risk-title {
                font-size: 1.5rem;
            }

            .risk-header-top {
                flex-direction: column;
                gap: 16px;
            }

            .risk-badges {
                align-items: flex-start;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="risk-detail-container">
    <a href="{{ path('comprendre_risques') }}" class="back-button">
        <i class="fas fa-arrow-left"></i>
        Retour à la liste
    </a>

    <div class="risk-detail-card">
        <div class="risk-header">
            <div class="risk-header-top">
                <h1 class="risk-title">{{ risque.titre }}</h1>
                <div class="risk-badges">
                    {% set niveauClass = 'faible' %}
                    {% if risque.niveauRisque == 'critique' %}
                        {% set niveauClass = 'critique' %}
                    {% elseif risque.niveauRisque == 'élevé' %}
                        {% set niveauClass = 'eleve' %}
                    {% elseif risque.niveauRisque == 'moyen' %}
                        {% set niveauClass = 'moyen' %}
                    {% endif %}
                    <span class="badge badge-{{ niveauClass }}">
                        <i class="fas fa-exclamation-triangle"></i>
                        Niveau : {{ risque.niveauRisque|capitalize }}
                    </span>
                    {% set statutClass = 'en-cours' %}
                    {% if risque.statut == 'en_cours' %}
                        {% set statutClass = 'en-cours' %}
                    {% elseif risque.statut == 'traité' %}
                        {% set statutClass = 'traite' %}
                    {% elseif risque.statut == 'surveillé' %}
                        {% set statutClass = 'surveille' %}
                    {% else %}
                        {% set statutClass = 'archive' %}
                    {% endif %}
                    <span class="badge badge-{{ statutClass }}">
                        {% if risque.statut == 'en_cours' %}<i class="fas fa-clock"></i>
                        {% elseif risque.statut == 'traité' %}<i class="fas fa-check"></i>
                        {% elseif risque.statut == 'surveillé' %}<i class="fas fa-eye"></i>
                        {% else %}<i class="fas fa-archive"></i>{% endif %}
                        Statut : {{ risque.statut|replace({'_': ' '})|capitalize }}
                    </span>
                </div>
            </div>
            <div class="risk-meta-bar">
                <div class="meta-item">
                    <i class="fas fa-building"></i>
                    <span>{{ risque.service.nom }}</span>
                </div>
                <div class="meta-item">
                    <i class="fas fa-user"></i>
                    <span>{{ risque.responsable.prenom }} {{ risque.responsable.nom }}</span>
                </div>
                <div class="meta-item">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Détecté le {{ risque.dateDetection|date('d/m/Y') }}</span>
                </div>
                {% if risque.dateResolution %}
                <div class="meta-item">
                    <i class="fas fa-check-circle"></i>
                    <span>Résolu le {{ risque.dateResolution|date('d/m/Y') }}</span>
                </div>
                {% endif %}
            </div>
        </div>

        <div class="risk-section">
            <h2 class="section-title">
                <i class="fas fa-align-left"></i>
                Description
            </h2>
            <div class="section-content">
                <p>{{ risque.description }}</p>
            </div>
        </div>

        {% if risque.categorie %}
        <div class="risk-section">
            <h2 class="section-title">
                <i class="fas fa-tags"></i>
                Catégorie
            </h2>
            <div class="section-content">
                <p>{{ risque.categorie }}</p>
            </div>
        </div>
        {% endif %}

        <div class="risk-section">
            <h2 class="section-title">
                <i class="fas fa-chart-line"></i>
                Évaluation du risque
            </h2>
            <div class="info-grid">
                <div class="info-card">
                    <div class="info-label">Probabilité</div>
                    <div class="info-value">{{ risque.probabilite ?? 'N/A' }}/5</div>
                </div>
                <div class="info-card">
                    <div class="info-label">Gravité</div>
                    <div class="info-value">{{ risque.gravite ?? 'N/A' }}/5</div>
                </div>
                {% if risque.scoreRisque %}
                <div class="info-card">
                    <div class="info-label">Score de risque</div>
                    <div class="info-value">
                        <span class="score-display">{{ risque.scoreRisque }}/25</span>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        {% if risque.source %}
        <div class="risk-section">
            <h2 class="section-title">
                <i class="fas fa-search"></i>
                Source
            </h2>
            <div class="section-content">
                <p>{{ risque.source }}</p>
            </div>
        </div>
        {% endif %}

        {% if risque.mesuresPreventives %}
        <div class="risk-section">
            <h2 class="section-title">
                <i class="fas fa-shield-alt"></i>
                Mesures préventives
            </h2>
            <div class="section-content">
                <p>{{ risque.mesuresPreventives }}</p>
            </div>
        </div>
        {% endif %}

        {% if risque.mesuresCorrectives %}
        <div class="risk-section">
            <h2 class="section-title">
                <i class="fas fa-tools"></i>
                Mesures correctives
            </h2>
            <div class="section-content">
                <p>{{ risque.mesuresCorrectives }}</p>
            </div>
        </div>
        {% endif %}

        {% if risque.mesureEnCours %}
        <div class="risk-section">
            <h2 class="section-title">
                <i class="fas fa-clipboard-list"></i>
                Mesure en cours
            </h2>
            <div class="section-content">
                <p>{{ risque.mesureEnCours }}</p>
                {% if risque.mesureMiseEnPlace %}
                <div style="margin-top: 12px; padding: 12px; background: #f0fdf4; border-left: 4px solid #16a34a; border-radius: 6px;">
                    <strong style="color: #16a34a;">
                        <i class="fas fa-check-circle"></i> Mesure mise en place
                    </strong>
                </div>
                {% endif %}
            </div>
        </div>
        {% endif %}

        {% if risque.retourAction %}
        <div class="risk-section">
            <h2 class="section-title">
                <i class="fas fa-comment-dots"></i>
                Retour d'action
            </h2>
            <div class="section-content">
                <p>{{ risque.retourAction }}</p>
                {% if risque.auteurRetour %}
                <div style="margin-top: 12px; font-size: 13px; color: #6b7280;">
                    <i class="fas fa-user"></i> Par {{ risque.auteurRetour.prenom }} {{ risque.auteurRetour.nom }}
                    {% if risque.dateRetour %}
                        le {{ risque.dateRetour|date('d/m/Y à H:i') }}
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </div>
        {% endif %}

        {% if risque.commentaires %}
        <div class="risk-section">
            <h2 class="section-title">
                <i class="fas fa-comments"></i>
                Commentaires
            </h2>
            <div class="section-content">
                <p>{{ risque.commentaires }}</p>
            </div>
        </div>
        {% endif %}

        {% if risque.lieu %}
        <div class="risk-section">
            <h2 class="section-title">
                <i class="fas fa-map-marker-alt"></i>
                Localisation
            </h2>
            <div class="section-content">
                <p>{{ risque.lieu.nom }}</p>
            </div>
        </div>
        {% endif %}

        {% if risque.observateurs|length > 0 %}
        <div class="risk-section">
            <h2 class="section-title">
                <i class="fas fa-users"></i>
                Observateurs
            </h2>
            <div class="section-content">
                <ul class="mesures-list">
                    {% for observateur in risque.observateurs %}
                    <li>{{ observateur.prenom }} {{ observateur.nom }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        {% endif %}

        <div class="risk-section">
            <h2 class="section-title">
                <i class="fas fa-info-circle"></i>
                Informations système
            </h2>
            <div class="info-grid">
                <div class="info-card">
                    <div class="info-label">Créé le</div>
                    <div class="info-value">{{ risque.createdAt|date('d/m/Y à H:i') }}</div>
                </div>
                {% if risque.updatedAt %}
                <div class="info-card">
                    <div class="info-label">Modifié le</div>
                    <div class="info-value">{{ risque.updatedAt|date('d/m/Y à H:i') }}</div>
                </div>
                {% endif %}
                {% if risque.createur %}
                <div class="info-card">
                    <div class="info-label">Créé par</div>
                    <div class="info-value">{{ risque.createur.prenom }} {{ risque.createur.nom }}</div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
