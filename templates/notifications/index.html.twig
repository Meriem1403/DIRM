{% extends 'base.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Messages flash -->
        {% for message in app.flashes('success') %}
        <div class="mb-4 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">{{ message }}</span>
        </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
        <div class="mb-4 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">{{ message }}</span>
        </div>
        {% endfor %}
        {% for message in app.flashes('info') %}
        <div class="mb-4 bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">{{ message }}</span>
        </div>
        {% endfor %}

        <!-- Header -->
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">
                        <i class="fas fa-bell mr-2"></i>Notifications
                    </h1>
                    <p class="text-lg text-gray-600 mt-2">{{ notifications|length }} notification(s)</p>
                </div>
                <div class="flex space-x-4">
                    {% if notifications|filter(n => not n.lu)|length > 0 %}
                    <form action="{{ path('notifications_marquer_toutes_lues') }}" method="POST" class="inline">
                        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors duration-300">
                            <i class="fas fa-check-double mr-2"></i>Marquer toutes comme lues
                        </button>
                    </form>
                    {% endif %}
                    <a href="{{ path('mes_risques') }}" style="background-color: #4b5563 !important; color: #ffffff !important; padding: 10px 16px; border-radius: 6px; text-decoration: none; font-weight: bold; display: inline-flex; align-items: center;"
                       onmouseover="this.style.backgroundColor='#374151'" onmouseout="this.style.backgroundColor='#4b5563'">
                        <i class="fas fa-arrow-left mr-2"></i>Retour
                    </a>
                </div>
            </div>
        </div>

        <!-- Liste des notifications -->
        {% if notifications|length > 0 %}
        <div class="space-y-4">
            {% for notification in notifications %}
            <div class="bg-white rounded-lg shadow p-6 {% if not notification.lu %}border-l-4 border-blue-500{% endif %}">
                <div class="flex items-start justify-between">
                    <div class="flex-1">
                        <div class="flex items-center space-x-3 mb-2">
                            <h3 class="text-lg font-semibold text-gray-900">{{ notification.titre }}</h3>
                            {% if not notification.lu %}
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                <i class="fas fa-circle mr-1"></i>Non lu
                            </span>
                            {% endif %}
                        </div>
                        
                        <p class="text-gray-700 mb-3 whitespace-pre-line">{{ notification.message }}</p>
                        
                        <div class="flex items-center space-x-4 text-sm text-gray-500">
                            <span>
                                <i class="fas fa-calendar mr-1"></i>
                                {{ notification.dateCreation|date('d/m/Y à H:i') }}
                            </span>
                            {% if notification.expediteur %}
                            <span>
                                <i class="fas fa-user mr-1"></i>
                                Par {{ notification.expediteur.prenom }} {{ notification.expediteur.nom }}
                            </span>
                            {% endif %}
                            {% if notification.risque %}
                            <a href="{{ path('notification_ouvrir_risque', {'id': notification.id}) }}" 
                               class="text-blue-600 hover:text-blue-800">
                                <i class="fas fa-external-link-alt mr-1"></i>Voir le risque
                            </a>
                            {% endif %}
                        </div>
                    </div>
                    
                    {% if not notification.lu %}
                    <form action="{{ path('notification_marquer_lu', {'id': notification.id}) }}" method="POST" class="ml-4">
                        <button type="submit" class="text-gray-400 hover:text-gray-600 transition-colors duration-300">
                            <i class="fas fa-check-circle text-lg"></i>
                        </button>
                    </form>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="text-center py-12">
            <div class="text-6xl text-gray-300 mb-4">
                <i class="fas fa-bell-slash"></i>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Aucune notification</h3>
            <p class="text-gray-600">Vous n'avez pas encore de notifications.</p>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
