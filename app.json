{
  "name": "DIRM Application",
  "description": "Application de gestion des démarches administratives numériques",
  "repository": "https://github.com/Meriem1403/DIRM",
  "logo": "https://symfony.com/logos/symfony_black_03.svg",
  "keywords": ["symfony", "php", "mysql"],
  "success_url": "/",
  "env": {
    "APP_ENV": {
      "value": "prod",
      "required": true
    },
    "APP_SECRET": {
      "generator": "secret",
      "required": true
    },
    "DATABASE_URL": {
      "description": "URL de connexion à la base de données MySQL",
      "required": true
    },
    "MAILER_DSN": {
      "description": "Configuration du serveur de mail",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql",
      "as": "DATABASE"
    }
  ],
  "buildpacks": [
    {
      "url": "heroku/php"
    }
  ],
  "scripts": {
    "postdeploy": "php bin/console doctrine:migrations:migrate --no-interaction"
  }
}
